// Pantalla de Éxito tras enviar los datos (Diseño Homogéneo)
void handleLogin() {
  if (server.hasArg("usuario_nombre") && server.hasArg("usuario_contacto")) {
    String nombre = server.arg("usuario_nombre");
    String contacto = server.arg("usuario_contacto");

    Serial.println("\n--- NUEVO USUARIO REGISTRADO ---");
    Serial.print("Nombre: "); Serial.println(nombre);
    Serial.print("Contacto/Matrícula: "); Serial.println(contacto);
    Serial.println("---------------------------------");

    String htmlResponse = "<html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'>";
    htmlResponse += "<style>body{font-family:'Segoe UI',sans-serif; background:radial-gradient(circle at top, #111827 0%, #030712 100%); color:#fff; display:flex; justify-content:center; align-items:center; min-height:100vh; margin:0;}";
    htmlResponse += ".card{background:rgba(31,41,55,0.6); backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,0.05); padding:40px; border-radius:20px; text-align:center; max-width:400px; width:90%; box-shadow:0 20px 40px rgba(0,0,0,0.5);}";
    htmlResponse += ".icon{width:60px; height:60px; background:#10b981; border-radius:50%; display:inline-flex; justify-content:center; align-items:center; margin-bottom:20px; box-shadow:0 0 20px rgba(16,185,129,0.4);}";
    htmlResponse += "h1{color:#10b981; font-size:24px; font-weight:800; margin-bottom:10px;} p{color:#9ca3af; font-size:15px; line-height:1.5;}</style></head><body>";
    htmlResponse += "<div class='card'><div class='icon'><svg width='30' height='30' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'></polyline></svg></div>";
    htmlResponse += "<h1>¡Acceso Concedido!</h1>";
    htmlResponse += "<p>Excelente, <strong>" + nombre + "</strong>.<br>Tu dispositivo se ha registrado correctamente en el nodo central. Ya puedes navegar.</p>";
    htmlResponse += "</div></body></html>";
    
    server.send(200, "text/html", htmlResponse);
  } else {
    server.send(400, "text/plain", "Datos incompletos.");
  }
}

// Servir el portal cautivo
void handlePortal() {
  server.sendHeader("Cache-Control", "no-cache, no-store, must-revalidate");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "-1");
  server.send(200, "text/html", HTML_PORTAL);
}

void setup() {
  Serial.begin(115200);
  Serial.println("\nIniciando Configuración del Portal Cautivo...");🙏🙏🙏🙏🍌🍌🍌🍌🍌🍌🍌🔥🔥🔥🔥🔥🔥🔥🔥🔥

  // 1. Configurar la ESP32 en Modo Access Point (AP) 🙏🙏🙏🙏🍌🍌🍌🍌🍌🍌🍌🔥🔥🔥🔥🔥🔥🔥🔥🔥
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(apIP, apIP, netMsk);
  WiFi.softAP(SSID_NAME); 

  Serial.print("Red Wi-Fi activa: ");
  Serial.println(SSID_NAME);
  Serial.print("Dirección IP del servidor: ");
  Serial.println(WiFi.softAPIP());

  // 2. Levantar el Servidor DNS (Redirección total)
  dnsServer.start(DNS_PORT, "*", apIP);

  // 3. Rutas del Servidor Web
  server.on("/", handlePortal);
  server.on("/login", HTTP_POST, handleLogin);
  
  server.onNotFound([]() {
    server.sendHeader("Location", String("http://") + apIP.toString(), true);
    server.send(302, "text/plain", ""); 
  });

  server.begin();
  Serial.println("Servidor Web listo.");
}

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();
}
